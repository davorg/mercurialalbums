[% page_title = "Home" %]
<section class="hero hero-grid">
  <div class="hero-art">
    <img
      src="/assets/mercury.png"
      alt="Mercury, the Roman messenger, DJing on twin decks"
      width="1200" height="675"
      loading="lazy" decoding="async">
  </div>

  <div class="hero-copy">
    <h1>Mercury Prize shortlists</h1>
    <p>
      Explore every shortlisted album and winner from 1992 to today.
      Winners are clearly marked, and each year page links through to
      the relevant artist and album pages.
    </p>
    <p>
      <strong>Start browsing:</strong>
      <a href="/year/">Years</a> · <a href="/artist/">Artists</a> · <a href="/album/">Albums</a>
    </p>
    <p class="fine-print">
      An independent, non-commercial project. Corrections welcome.
    </p>
  </div>
</section>

[% IF latest_year -%]
<section class="latest-feature" aria-labelledby="latest-shortlist-heading">
  <div class="latest-feature-copy">
    <p class="eyebrow">New on Mercurial Albums</p>
    <h2 id="latest-shortlist-heading">The [% latest_year.year %] shortlist is here</h2>
[% IF latest_year.winner_announcement_date -%]
    <p class="announcement-date">Winner announced <time datetime="[% latest_year.winner_announcement_date.ymd %]">[% latest_year.winner_announcement_date_display %]</time></p>
[% END -%]
    <p>
      Explore all [% latest_album_count %] Albums of the Year, with artist profiles,
      album artwork and Amazon Music links.
    </p>
    <p><a class="latest-feature-link" href="[% latest_year.url_path %]/">Browse the [% latest_year.year %] shortlist &rarr;</a></p>
  </div>
  <div class="latest-covers" aria-hidden="true">
[% FOREACH album IN latest_albums -%]
    <img src="/assets/albums/[% album.cover_image | html %]" alt=""
         width="500" height="500" loading="lazy" decoding="async">
[% END -%]
  </div>
</section>
[% END -%]
